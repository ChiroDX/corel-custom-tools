# ── Required ──────────────────────────────────────────────
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key...

# ── Optional: Anthropic / Claude ──────────────────────────
# Get yours at: https://console.anthropic.com/
# Leave blank if you don't want to use Claude models
ANTHROPIC_API_KEY=

# ── Optional: Ollama (local models) ───────────────────────
# Install from https://ollama.ai — runs models locally for free
# Default model to use (run: ollama pull llama3)
OLLAMA_MODEL=llama3
# Default URL (change if Ollama is on a different machine)
OLLAMA_URL=http://localhost:11434

# ── Server config ──────────────────────────────────────────
PORT=3000
